# Настройки склада другого отдела. Скопируйте, например, в .env.otdel2 и поправьте.
# Запуск: python app.py --env .env.otdel2
# Общие настройки (FLASK_DEBUG и т.п.) по-прежнему берутся из .env, значения здесь важнее.

# Код склада: латиница, цифры, - и _. От него зависят имя базы (otdel2.db),
# папка копий (backups/otdel2) и имена cookie входа. После запуска не меняйте.
SCLAD_INSTANCE=otdel2

# Название в шапке, на странице входа и на актах ТО
SCLAD_NAME=Склад отдела 2

# Порт для python app.py (у основного склада 5000)
SCLAD_PORT=5001

# Свой секретный ключ (рекомендуется; если не задан, берётся из .env):
#   python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=вставьте_сюда_ключ

# Необязательно: другой путь к базе или к папке копий
# SCLAD_DATABASE=D:\sklad\otdel2.db
# SCLAD_BACKUP_DIR=D:\sklad\backups-otdel2
