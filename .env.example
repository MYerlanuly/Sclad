# Скопируйте в .env и задайте свои значения.
# Файл .env не коммитьте в репозиторий (в нём секреты).

# Секретный ключ Flask (сессии, flash). В продакшене обязательно задайте свой.
FLASK_SECRET_KEY=your-secret-key-here

# Режим отладки: 1 / 0 или true / false. В продакшене должно быть 0.
FLASK_DEBUG=0
